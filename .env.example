# Copy to .env and fill in. NEVER commit real keys.
# Generate these in WooCommerce: WooCommerce > Settings > Advanced > REST API
#   -> Add key -> Permissions: Read
WC_STORE_URL=https://your-store.example.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional tuning (defaults shown)
WC_API_VERSION=wc/v3
WC_TIMEOUT=20
WC_MAX_RETRIES=4
WC_PER_PAGE=100
WC_RPS=5
WC_VERIFY_SSL=true
